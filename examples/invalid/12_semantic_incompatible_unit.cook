// ============================================================================
// DIGITAL COOKBOOK — Example 12: Semantic Error — Incompatible Measurement Unit
// EGGS cannot be measured in milliliters (ML), only whole PIECE units
// ============================================================================

RECIPE PANCAKE;

ADD(2, CUP, FLOUR);
ADD(250, ML, EGG);
ADD(1, CUP, MILK);

MIX(3, MINUTES);
FRY(5, MINUTES);

SERVE;
