// ============================================================================
// DIGITAL COOKBOOK — Example 05: French Butter Omelette
// Valid Pan-Fried Breakfast Program
// ============================================================================

RECIPE FRENCH_OMELETTE;

ADD(3, PIECE, EGG);
ADD(1, PINCH, SALT);
ADD(1, PINCH, PEPPER);

WHISK(90, SECONDS);

ADD(20, GRAM, BUTTER);
FRY(3, MINUTES);

ADD(30, GRAM, CHEESE);

SERVE;
