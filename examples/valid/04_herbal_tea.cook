// ============================================================================
// DIGITAL COOKBOOK — Example 04: Aromatic Herbal Spiced Tea
// Valid Botanical Infusion Program
// ============================================================================

RECIPE HERBAL_TEA;

ADD(500, ML, WATER);
ADD(10, GRAM, GINGER);
ADD(2, PIECE, CARDAMOM);

BOIL(4, MINUTES);

ADD(5, GRAM, TEA_LEAVES);
SIMMER(2, MINUTES);

ADD(2, TBSP, HONEY);
REST(1, MINUTES);

SERVE;
