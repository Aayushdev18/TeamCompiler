// ============================================================================
// DIGITAL COOKBOOK — Example 06: Crisp Mediterranean Salad
// Valid Raw Produce Program
// ============================================================================

RECIPE FRESH_SALAD;

CHOP(TOMATO);
CHOP(CUCUMBER);
CHOP(ONION);

ADD(150, GRAM, LETTUCE);
ADD(2, PIECE, TOMATO);
ADD(1, PIECE, CUCUMBER);
ADD(50, GRAM, CHEESE);

ADD(2, TBSP, OIL);
ADD(1, TBSP, LEMON_JUICE);
ADD(1, PINCH, SALT);

MIX(1, MINUTES);
CHILL(10, MINUTES);

SERVE;
