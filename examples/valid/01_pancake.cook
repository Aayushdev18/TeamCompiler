// ============================================================================
// DIGITAL COOKBOOK — Example 01: Classic Golden Fluffy Pancake
// Valid Cookbook DSL Program
// ============================================================================

RECIPE PANCAKE;

# Measure and dispense dry base ingredients
ADD(2, CUP, FLOUR);
ADD(2, TBSP, SUGAR);
ADD(1, TSP, BAKING_POWDER);
ADD(1, PINCH, SALT);

# Dispense binding liquids and dairy
ADD(1, PIECE, EGG);
ADD(1, CUP, MILK);
ADD(2, TBSP, BUTTER);

# Mechanical preparation: blend batter until smooth
WHISK(2, MINUTES);
REST(5, MINUTES);

# Thermal cooking on medium griddle
FRY(4, MINUTES);

# Presentation of freshly cooked pancake
SERVE;
