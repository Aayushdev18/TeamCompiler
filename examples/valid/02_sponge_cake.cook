// ============================================================================
// DIGITAL COOKBOOK — Example 02: Vanilla Sponge Cake
// Valid Oven-Baked Confectionery Program
// ============================================================================

RECIPE SPONGE_CAKE;

# Core structure ingredients
ADD(250, GRAM, FLOUR);
ADD(200, GRAM, SUGAR);
ADD(150, GRAM, BUTTER);
ADD(3, PIECE, EGG);

# Flavor and leavening agents
ADD(1, TSP, BAKING_POWDER);
ADD(1, TSP, VANILLA);
ADD(50, ML, MILK);

# High-speed aeration and mechanical mixing
MIX(5, MINUTES);

# Controlled convection oven bake
BAKE(30, MINUTES);

# Stabilization resting cycle
REST(15, MINUTES);

SERVE;
