// ============================================================================
// DIGITAL COOKBOOK — Example 03: Italian Pasta Carbonara
// Valid Savory Culinary Program
// ============================================================================

RECIPE PASTA;

# Boiling phase
ADD(1000, ML, WATER);
ADD(10, GRAM, SALT);
ADD(250, GRAM, PASTA);

BOIL(9, MINUTES);

# Sauce preparation
CHOP(GARLIC);
ADD(100, GRAM, BACON);
FRY(4, MINUTES);

ADD(2, PIECE, EGG);
ADD(50, GRAM, CHEESE);
ADD(1, PINCH, PEPPER);

# Final emulsion toss
MIX(2, MINUTES);

SERVE;
